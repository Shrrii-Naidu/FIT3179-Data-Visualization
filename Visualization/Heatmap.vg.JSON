{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 300,
  "background": "#ece0d1",
  "title": {
    "text": "Roast Levels of Reviewed Coffees by Year, 2001\u20132026",
    "subtitle": "Medium-Light roasts led from 2013 to 2023, and Light roasts are now catching up",
    "anchor": "middle"
  },
  "layer": [
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/reviews_trimmed.csv",
        "format": {
          "type": "csv",
          "parse": {
            "review_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.roast_level) && datum.roast_level !== '' && datum.roast_level !== 'NA' && isValid(datum.review_year) && datum.review_year >= 2001"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "review_year",
            "roast_level"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "n",
              "as": "year_total"
            }
          ],
          "groupby": [
            "review_year"
          ]
        },
        {
          "calculate": "datum.n / datum.year_total",
          "as": "share"
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "review_year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "roast_level",
          "type": "ordinal",
          "sort": [
            "Light",
            "Medium-Light",
            "Medium",
            "Medium-Dark",
            "Dark",
            "Very Dark"
          ],
          "axis": {
            "title": null
          }
        },
        "color": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "range": [
              "#fff4de",
              "#fbd98a",
              "#f2b13a",
              "#c27500",
              "#6b3d00"
            ]
          },
          "legend": {
            "title": "Share of year",
            "format": "%"
          }
        },
        "tooltip": [
          {
            "field": "review_year",
            "title": "Year"
          },
          {
            "field": "roast_level",
            "title": "Roast"
          },
          {
            "field": "n",
            "title": "Reviews"
          },
          {
            "field": "share",
            "title": "Share",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Source: Coffee Review via Kaggle. Each column adds up to 100% of that year's reviews with a recorded roast level."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "color": "#6f4e37"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "x": {
          "value": 0
        },
        "y": {
          "value": 352
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Blank = no reviews. 2026 is a partial year."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "color": "#6f4e37"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "x": {
          "value": 0
        },
        "y": {
          "value": 368
        }
      }
    }
  ],
  "config": {
    "font": "Roboto Flex",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Roboto Flex",
      "fontSize": 16,
      "fontWeight": 500,
      "color": "#38220f",
      "subtitleFont": "Roboto Flex",
      "subtitleFontSize": 12,
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f4e37"
    },
    "axis": {
      "labelFont": "Roboto Flex",
      "labelFontSize": 11,
      "labelColor": "#38220f",
      "titleFont": "Roboto Flex",
      "titleFontSize": 12,
      "titleColor": "#6f4e37",
      "domainColor": "#38220f",
      "tickColor": "#38220f"
    },
    "legend": {
      "labelFont": "Roboto Flex",
      "titleFont": "Roboto Flex",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#38220f",
      "titleColor": "#6f4e37"
    },
    "text": {
      "font": "Roboto Flex"
    }
  }
}
