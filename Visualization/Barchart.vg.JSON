{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top Ten Coffee Producers, 2024",
    "subtitle": "Brazil grows more coffee than Vietnam and Colombia combined",
    "anchor": "middle"
  },
  "width": 560,
  "height": 320,
  "background": "transparent",
  "config": {
    "font": "Roboto Flex",
    "title": {
      "font": "Roboto Flex",
      "fontSize": 16,
      "fontWeight": 500,
      "color": "#38220f",
      "subtitleFont": "Roboto Flex",
      "subtitleFontSize": 12,
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f4e37"
    },
    "axis": {
      "labelFont": "Roboto Flex",
      "labelFontSize": 11,
      "labelColor": "#38220f",
      "titleFont": "Roboto Flex",
      "titleFontSize": 12,
      "titleColor": "#6f4e37",
      "domainColor": "#38220f",
      "tickColor": "#38220f",
      "gridColor": "#d8c8b4",
      "labelLimit": 220
    },
    "text": {
      "font": "Roboto Flex"
    }
  },
  "data": {
    "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/fao_production.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "tonnes": "number",
        "m49": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2024 && isValid(datum.tonnes)"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "tonnes",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 10"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "title": null,
          "sort": "-x"
        },
        "x": {
          "field": "tonnes",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "axis": {
            "format": "~s"
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.country === 'Brazil'",
              "value": "#2c4a6b"
            },
            {
              "test": "datum.country === 'Vietnam' || datum.country === 'Colombia'",
              "value": "#6f8fb0"
            }
          ],
          "value": "#c5d3e2"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "tonnes",
            "title": "Tonnes",
            "format": ","
          },
          {
            "field": "flag",
            "title": "Data flag"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Source: FAOSTAT (coffee production, 2024)."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "color": "#6f4e37"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "x": {
          "value": 0
        },
        "y": {
          "value": 372
        }
      }
    }
  ]
}
