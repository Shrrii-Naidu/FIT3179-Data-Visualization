          {
            "t": "Ethiopia",
            "lon": 61,
            "lat": 3
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#38220f",
        "align": "left",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 20"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "reviews",
              "as": "total"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "hub"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#1f5f6b",
        "stroke": "#ece0d1",
        "strokeWidth": 1,
        "opacity": 1,
        "size": 60
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "hub",
            "type": "nominal",
            "title": "Roaster location"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Reviews (six origins)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 20"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "reviews",
              "as": "total"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "hub"
          ]
        },
        {
          "calculate": "toNumber(datum.lat) + 4.5",
          "as": "lat_l"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1f5f6b",
        "baseline": "bottom"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_l",
          "type": "quantitative"
        },
        "text": {
          "field": "hub",
          "type": "nominal"
        }
      }
    },
    {
