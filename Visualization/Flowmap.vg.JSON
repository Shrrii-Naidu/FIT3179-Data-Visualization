{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Origin and Roaster Locations of Reviewed Single-Origin Coffees",
    "subtitle": "Most reviewed coffees from six origins are roasted in the United States and Taiwan",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "middle"
  },
  "width": 640,
  "height": 336,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 55
  },
  "background": "transparent",
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4ece9",
        "stroke": "#b9ad99",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#c9d6d2",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4eee3",
        "stroke": "#d6c9b4",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "flow_id"
            ]
          }
        }
      ],
      "mark": {
        "type": "line",
        "color": "#7b3fa0",
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "flow_id",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "reviews",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              1050
            ],
            "range": [
              0,
              16
            ]
          },
          "legend": {
            "title": "Reviews",
            "values": [
              50,
              200,
              500,
              1000
            ],
            "symbolStrokeColor": "#7b3fa0",
            "orient": "right",
            "symbolFillColor": "#7b3fa0"
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 0.95
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "origin",
            "type": "nominal",
            "title": "Grown in"
          },
          {
            "field": "hub",
            "type": "nominal",
            "title": "Roasted in"
          },
          {
            "field": "reviews",
            "type": "quantitative",
            "title": "Reviews"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 0"
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "origin"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#1f5f6b",
        "size": 60,
        "stroke": "#ece0d1",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 0"
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "origin"
          ]
        },
        {
          "filter": "indexof(['Brazil','Indonesia'], datum.origin) >= 0"
        },
        {
          "calculate": "toNumber(datum.lon) + 2.5",
          "as": "lon_l"
        },
        {
          "calculate": "toNumber(datum.lat) - 1",
          "as": "lat_l"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#38220f",
        "align": "left",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon_l",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_l",
          "type": "quantitative"
        },
        "text": {
          "field": "origin",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 0"
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "origin"
          ]
        },
        {
          "filter": "indexof(['Colombia','Guatemala'], datum.origin) >= 0"
        },
        {
          "calculate": "toNumber(datum.lon) - 3.5",
          "as": "lon_l"
        },
        {
          "calculate": "toNumber(datum.lat) + (datum.origin == 'Ethiopia' ? 1 : 0)",
          "as": "lat_l"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#38220f",
        "align": "right",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon_l",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_l",
          "type": "quantitative"
        },
        "text": {
          "field": "origin",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://shrrii-naidu.github.io/FIT3179-Data-Visualization/Data/coffee_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "reviews": "number",
            "step": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.step == 0"
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": [
            "origin"
          ]
        },
        {
          "filter": "datum.origin == 'Kenya'"
        },
        {
          "calculate": "toNumber(datum.lat) - 3.5",
          "as": "lat_l"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#38220f",
        "align": "center",
        "baseline": "top"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_l",
          "type": "quantitative"
        },
        "text": {
          "field": "origin",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "id": "e",
            "lon": 41.5,
            "lat": 8.2,
            "o": 0
          },
          {
            "id": "e",
            "lon": 60,
            "lat": 3,
            "o": 1
          }
        ]
      },
      "mark": {
        "type": "line",
        "color": "#38220f",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "id",
          "type": "nominal"
        },
        "order": {
          "field": "o",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
